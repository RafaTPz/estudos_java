package aula2208;

public class Math06 {

	public static void main(String[] args) {
		String s = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.,@#%*&!";
		int t = s.length();
		String senha = "";
		for(int i=1;i<=10;i++) {
			int n = (int)(Math.random()*t);
			senha += s.charAt(n);
		}
		System.out.println(senha);
	}

}
