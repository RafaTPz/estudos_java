package lista01;

import javax.swing.JOptionPane;

public class SomaToMedia {

	public static void main(String[] args) {
		int QUANTIDADE_NUMEROS = 10;
		float numero, media = 0;
		
		for (int n = 0; n<QUANTIDADE_NUMEROS;n++) {
			numero = Float.parseFloat(JOptionPane.showInputDialog("Digite o numero "+(n+1)+":"));
			media += numero;
		}
		media = media/QUANTIDADE_NUMEROS;
		System.out.println("A média é: "+media);

	}

}
