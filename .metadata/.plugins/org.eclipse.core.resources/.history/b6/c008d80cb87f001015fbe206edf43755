package aula2208;

import javax.swing.JOptionPane;

public class Math02 {

	public static void main(String[] args) {
		final int PASSAGEIROS_POR_ONIBUS = 40;
		int numeroAlunos = Integer.parseInt(JOptionPane.showInputDialog("QUantos alunos vão ao passeio? "));
		System.out.println(Math.ceil(numeroAlunos/PASSAGEIROS_POR_ONIBUS));
	}

}
